{"nodes": [{"id": "project_guide_doc", "label": "PROJECT_GUIDE.md (Technical Reference)", "file_type": "document", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_fedavg", "label": "FedAvg (Federated Averaging)", "file_type": "concept", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_fedprox", "label": "FedProx Personalization", "file_type": "concept", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_differential_privacy", "label": "Differential Privacy (DP-SGD via Opacus)", "file_type": "concept", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_dirichlet_partitioning", "label": "Dirichlet Non-IID Partitioning", "file_type": "concept", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_membership_inference_attack", "label": "Yeom et al. Loss-Threshold Membership-Inference Attack", "file_type": "concept", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_drift_aware_controller", "label": "Drift-Aware Federated Controller", "file_type": "concept", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_fixed_threshold_artifact", "label": "Fixed-0.5-Threshold / Label-Shift Artifact", "file_type": "rationale", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client 1's apparent FedAvg collapse (78.9% local -> 34.7% FedAvg) was diagnosed as substantially a fixed 0.5 decision-threshold artifact under per-client label shift, not a training failure: AUC stayed 0.822 and balanced accuracy was 0.500 (chance) for every one of the 5 clients under the unweighted, fixed-threshold setup. This motivated per-client pos_weight loss weighting and per-client threshold tuning as the fix."}, {"id": "concept_federated_pooling_privacy", "label": "Federated Pooling as Dominant Privacy Mechanism", "file_type": "rationale", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MIA audit found fully-local per-hospital models leak measurably more (attack AUC up to 0.63) than the shared FedAvg/FedProx model (attack AUC ~0.485, indistinguishable from 0.5) at every epsilon including no DP -- suggesting pooling itself, not DP noise, is the dominant privacy mechanism in this setup. Flagged as provisional: these models predate the fixed-threshold correction and should be re-run."}, {"id": "concept_cdc_diabetes_dataset", "label": "CDC Diabetes Health Indicators Dataset (UCI id 891)", "file_type": "concept", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_no_batchnorm_decision", "label": "No-BatchNorm Model Design Decision", "file_type": "rationale", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opacus's per-sample gradient computation for DP-SGD does not support BatchNorm, so DiabetesMLP was designed with LayerNorm instead of BatchNorm from Step 4 onward (before any FL/DP code existed) specifically to avoid a rework later. Verified via opacus.validators.ModuleValidator.validate()."}, {"id": "concept_personalized_fl_claim_gap", "label": "External Review Finding: FedProx Is Not Personalization", "file_type": "rationale", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An outside pre-submission review found that FedProx produces one shared global model (Li et al. 2020), so the project's title/research question claiming 'personalized FL' is not supported by what is implemented. Response plan: either reframe (drop the claim) or implement real personalization (Ditto/FedPer)."}, {"id": "data_loaders_load_diabetes_data", "label": "load_diabetes_data()", "file_type": "code", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_loaders_ensure_ssl_certs", "label": "_ensure_ssl_certs()", "file_type": "code", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_partition_dirichlet_partition", "label": "dirichlet_partition()", "file_type": "code", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_partition_build_experiment_splits", "label": "build_experiment_splits()", "file_type": "code", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "models_mlp_diabetesmlp", "label": "DiabetesMLP", "file_type": "code", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fl_client_diabetesflowerclient", "label": "DiabetesFlowerClient", "file_type": "code", "source_file": "PROJECT_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fl_client_compute_pos_weight", "label"